<view class="page" wx:if="{{order}}">
  <view>状态 {{order.status}} 支付 {{order.payment_status}} 取餐号 {{order.pickup_number}}</view>
  <view wx:if="{{order.table_no}}">桌号 {{order.table_no}}</view>
  <view wx:if="{{order.scheduled_for}}">预约 {{order.scheduled_for}}</view>
  <view wx:for="{{order.items}}" wx:key="sku_id">{{item.product_name}} {{item.sku_name}} {{item.options}} x{{item.qty}} ¥{{item.line_total_cents / 100}}</view>
  <view>商品 ¥{{order.goods_cents / 100}} 包装 ¥{{order.packing_cents / 100}} 优惠 ¥{{order.discount_cents / 100}}</view>
  <view>应付 ¥{{order.payable_cents / 100}}</view>
  <view wx:if="{{order.remark}}">备注 {{order.remark}}</view>
  <view wx:for="{{order.events}}" wx:key="created_at">{{item.to_status}} {{item.created_at}}</view>
  <button wx:if="{{canPay}}" bindtap="continuePay">继续支付</button>
  <button wx:if="{{canDoCancel}}" bindtap="cancel">取消</button>
  <button bindtap="reorder">再来一单</button>
</view>
