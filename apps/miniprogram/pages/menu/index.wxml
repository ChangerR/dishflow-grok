<view class="page">
  <view class="head">{{storeName}} {{isOpen ? '营业中' : '休息中'}} {{scene === 'DINE_IN' ? '堂食' : '自取'}} {{tableNo}}</view>
  <view wx:if="{{announcement}}">{{announcement}}</view>
  <input placeholder="搜索菜品" bindinput="onKeyword" />
  <view wx:for="{{categories}}" wx:key="id">
    <view class="cat">{{item.name}}</view>
    <view wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="id" class="dish">
      <text>{{dish.name}} 起 ¥{{dish.from_price_cents / 100}}</text>
      <button size="mini" data-sku="{{dish.skus[0].id}}" bindtap="add">加入</button>
    </view>
  </view>
  <button bindtap="checkout">去结算 {{cart.length}}</button>
</view>
